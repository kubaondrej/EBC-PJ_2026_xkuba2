<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cz.mendelu.projektjava_xkuba2.controllers.PharmaciesTableController">

    <HBox alignment="CENTER" spacing="15.0">
        <TextField fx:id="txtSearch" onKeyTyped="#searchPharmacy" promptText="ZADEJTE NÁZEV LÉKÁRNY" prefWidth="300.0" />
        <CheckBox fx:id="searchByAddressChbx" onAction="#pharmSearchAttributeChbxChanged"/>
        <Button text="VYMAZAT FILTR" onAction="#resetSearchFilter"/>
    </HBox>

    <TableView fx:id="pharmaciesTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="name" text="Název" prefWidth="280.0" styleClass="highlightedColumn"/>
            <TableColumn fx:id="colStreetName" text="Ulice" prefWidth="280.0"/>
            <TableColumn fx:id="colStreetNumber" text="Číslo popisné" prefWidth="180.0"/>
            <TableColumn fx:id="colPostcode" text="PSČ" prefWidth="200.0"/>
            <TableColumn fx:id="colCity" text="Město" prefWidth="90.0"/>
        </columns>
    </TableView>
    <Label fx:id="entriesCountLabel"/>
</VBox>