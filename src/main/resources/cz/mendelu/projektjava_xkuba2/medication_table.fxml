<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cz.mendelu.projektjava_xkuba2.ui_controllers.MedicationsTableController">

    <HBox alignment="CENTER" spacing="15.0">
        <Label text="VYHLEDAT POMOCÍ ÚČINNÉ SLOŽKY:" styleClass="blue_label"/>
        <CheckBox fx:id="searchByActiveIngredientChbx" onAction="#medSearchAttributeChbxChanged"/>
        <TextField fx:id="txtSearch" onKeyTyped="#searchMedication" promptText="např. Voltaren" prefWidth="300.0" />
        <Button text="VYMAZAT FILTR" onAction="#resetSearchFilter"/>
    </HBox>

    <VBox alignment="CENTER">
    <TableView fx:id="medicationsTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="280.0"/>
            <TableColumn fx:id="colName" text="Název" styleClass="highlightedColumn" prefWidth="180.0"/>
            <TableColumn fx:id="colActiveIngredient" text="Účinná látka" prefWidth="200.0"/>
            <TableColumn fx:id="colDosage" text="Dávka (mg)" prefWidth="90.0"/>
            <TableColumn fx:id="colIsPrescriptionOnly" text="Na předpis" prefWidth="90.0"/>
            <TableColumn fx:id="colMaxPackages" text="Max. balení" prefWidth="90.0"/>
        </columns>
    </TableView>
    <Label fx:id="entriesCountLabel"/>
    </VBox>
</VBox>