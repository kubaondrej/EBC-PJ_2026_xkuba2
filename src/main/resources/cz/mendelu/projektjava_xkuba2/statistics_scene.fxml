<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Separator?>

<VBox alignment="TOP_CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17"
      stylesheets="@style.css"
      fx:controller="cz.mendelu.projektjava_xkuba2.ui_controllers.StatisticsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>




    <Label text="STATISTIKY PROGRAMU" style="-fx-font-size: 25px; -fx-font-weight: bold;"/>
    <Separator prefWidth="200.0" />
    <HBox alignment="CENTER">
        <Label text="POČET LÉČIV V DATABÁZI: " styleClass="stat_title"/>
        <Label fx:id="lblMedicationCount" styleClass="stat_value"/>
    </HBox>
    <Separator prefWidth="200.0" />
    <HBox alignment="CENTER">
        <Label text="POČET LÉČIV NA PŘEDPIS: " styleClass="stat_title"/>
        <Label fx:id="lblPrescriptionMedicationCount" styleClass="stat_value"/>
    </HBox>
    <Separator prefWidth="200.0" />
    <HBox alignment="CENTER">
        <Label text="POČET VOLNĚ PRODEJNÝCH LÉČIV " styleClass="stat_title"/>
        <Label fx:id="lblOTCMedicationCount" styleClass="stat_value"/>
    </HBox>
    <Separator prefWidth="200.0" />
    <HBox alignment="CENTER">
        <Label text="VELIKOST JSON SOUBORU LÉKŮ: " styleClass="stat_title"/>
        <Label fx:id="lblMedicationsFileSize" styleClass="stat_value"/>
    </HBox>
    <Button prefWidth="100" text="ZPĚT" onAction="#backToMenu"/>




</VBox>