<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>


<?import javafx.scene.control.Separator?>
<VBox alignment="TOP_CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17"
      stylesheets="@style.css"
      fx:controller="cz.mendelu.projektjava_xkuba2.controllers.PharmaciesController">
    <padding>
        <Insets bottom="5.0" left="20.0" right="20.0" top="5.0"/>
    </padding>

    <Button onAction="#testPharmacies" text="PŘIDAT LÉKÁRNY"/>
    <Button onAction="#addMedicationToStock" text="PŘIDAT STOCK NA SKLAD"/>
    <Separator prefWidth="200.0" />
    <fx:include source="medication_table.fxml" VBox.vgrow="ALWAYS"/>

    <Button prefWidth="100" text="ZPĚT" onAction="#backToMenu"/>

</VBox>