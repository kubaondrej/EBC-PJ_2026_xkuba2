<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>


<?import javafx.scene.control.Separator?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Spinner?>
<VBox alignment="TOP_CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17"
      stylesheets="@style.css"
      fx:controller="cz.mendelu.projektjava_xkuba2.controllers.PharmaciesController">
    <padding>
        <Insets bottom="5.0" left="20.0" right="20.0" top="5.0"/>
    </padding>

    <HBox>
        <fx:include fx:id="pharmTable" source="pharmacies_table.fxml" VBox.vgrow="ALWAYS" minWidth="1000"/>
    </HBox>
    <Separator prefWidth="200.0" />

    <fx:include fx:id="medTable" source="medication_table.fxml" VBox.vgrow="ALWAYS"/>
    <HBox alignment="CENTER" spacing="10">
        <Button text="PŘIDAT NA POBOČKU" onAction="#addMedicationToStock"/>
        <Spinner fx:id="invCountSpinner" editable="true" prefWidth="100.0"/>
    </HBox>
    <Button prefWidth="100" text="ZPĚT" onAction="#backToMenu"/>
</VBox>