<VBox alignment="TOP_CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17"
      fx:controller="cz.mendelu.projektjava_xkuba2.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <HBox alignment="CENTER" spacing="10.0">
        <Button text="DATABÁZE LÉKŮ" onAction="#switchToMedDatabase"/>
        <Button text="SEZNAM LÉKÁREN" onAction="#SwitchToPharmDatabase"/>
    </HBox>

    <Label text="Seznam lekaren"/>

</VBox>